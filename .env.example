# Environment Configuration for Rehber Platform

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Central Database
# Use SQLite for instant local zero-dependency development:
DATABASE_URL=sqlite+aiosqlite:///./rehber.db
# Or use PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rehber

# Security
JWT_SECRET=rehber-rural-education-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SMS Cellular Gateway Configuration
SMS_GATEWAY_API_KEY=rehber-sms-gw-test-key-xyz
SMS_GATEWAY_PHONE_NUMBER=+923001234567

# Network Quality Latency Threshold (ms)
LATENCY_THRESHOLD_MS=3000

# Optional Google Gemini API Key for Online Cloud AI Tutoring
# If blank, Rehber automatically falls back to deterministic local educational rules engine
GEMINI_API_KEY=

# Next.js Web Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
